{
  "name": "claude-performance-analyzer",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "bun run --filter @cpa/collector start",
    "dev": "bun run --filter @cpa/collector dev",
    "app": "bun run --filter @cpa/menubar start",
    "build:plugin": "bun apps/mcp/scripts/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
